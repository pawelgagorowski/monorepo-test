{
  "name": "fe-clone-test",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x",
    "npm": ">=11.10.0"
  },
  "scripts": {
    "dev": "next dev -p 3001",
    "dev:remote-api": "NEXT_PUBLIC_API_URL=https://api.develop.example.com next dev -p 3001",
    "build": "npm run check-all && next build",
    "check-all": "npm test && biome check && npm run tsc-check",
    "start": "next start -p 3001",
    "tsc-check": "tsc --noEmit",
    "lint": "biome lint .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "lint-staged": "lint-staged",
    "prepare": "husky install"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css}": "biome check --write --no-errors-on-unmatched"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@playwright/test": "1.58.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "husky": "^8.0.2",
    "lint-staged": "^16.2.7",
    "typescript": "^5.6.0",
    "vitest": "^2.0.5"
  }
}
